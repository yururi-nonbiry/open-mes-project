# Django/Backend Service Settings
# Djangoのシークレットキー。本番環境では必ず変更してください。
SECRET_KEY='django-insecure-change-me'
# デバッグモード。本番環境ではFalseに設定してください。
DEBUG=False

# 許可するホスト名。カンマ区切りで指定します。
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1,frontend,backend

# CSRF信頼済みオリジン。カンマ区切りで指定します。
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://localhost:8000

# CORS許可オリジン。カンマ区切りで指定します。
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost

# Database Settings
DATABASE_URL=postgres://django:django@db:5432/open_mes
# Postgres Container Settings
POSTGRES_USER=django
POSTGRES_PASSWORD=django
POSTGRES_DB=open_mes

# 本番環境 (compose.prod.yml) で起動するコンテナの切り替え (1: 起動する, 0: 起動しない)
# 未設定の場合はどちらも起動します。
# DBコンテナ。0にする場合は DATABASE_URL を外部のDBに向けてください。
START_DB=1
# Nginx (reverse-proxy) コンテナ。
START_NGINX=1

# --- セキュリティ (ログイン制限・監査ログ) ---
# 本番構成 (compose.prod.yml / compose.https.yml) では nginx が付ける X-Real-IP をアクセス元IPとして使います(既定 True)。
# Django に nginx を経由せず直接アクセスできる構成では False にしてください。
# TRUST_X_REAL_IP=True
# compose.prod.yml の nginx の待ち受けアドレスとポート。ホストの nginx を前段に置く場合は 127.0.0.1 と 8080 などにします。
# NGINX_BIND=0.0.0.0
# NGINX_PORT=80
# 前段のプロキシが付ける X-Real-IP を信頼する場合、そのプロキシのアドレス(CIDR)。Docker のブリッジは 172.16.0.0/12。
# NGINX_REAL_IP_FROM=127.0.0.1
# ログイン失敗によるロック・ブロック・画像認証のしきい値(既定値)
# LOGIN_LOCK_THRESHOLD=5
# LOGIN_LOCK_DURATIONS_MINUTES=5,30
# LOGIN_IP_BLOCK_THRESHOLD=20
# LOGIN_IP_BLOCK_WINDOW_MINUTES=30
# LOGIN_IP_BLOCK_MINUTES=30
# LOGIN_CAPTCHA_THRESHOLD=3
# 監査ログの保存日数
# ACCESS_LOG_RETENTION_DAYS=365

# Certbot / HTTPS Settings
# 証明書を取得するドメイン
DOMAIN=your-domain.com
# 証明書取得に使用するメールアドレス
EMAIL=your-email@example.com
# テスト用証明書を使用するかどうか (true: テスト用, false: 本番用)
# テスト用はレート制限が緩いため、動作確認時はtrueにすることを推奨します。
CERTBOT_USE_STAGING=true
